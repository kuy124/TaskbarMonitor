CXX = g++
RC = windres
CXXFLAGS = -O3 -mwindows -municode -Wall -Wextra -std=c++17 -Isrc
LDFLAGS = -static -liphlpapi -lgdi32 -ldwmapi -lpdh -lpsapi -lshell32 -lcomctl32 -lcomdlg32 -lole32 -loleaut32 -luiautomationcore -luuid -lwbemuuid

SRCS = src/Config.cpp \
       src/Theme.cpp \
       src/Metrics.cpp \
       src/HardwareSensors.cpp \
       src/Renderer.cpp \
       src/TaskbarSync.cpp \
       src/SettingsWindow.cpp \
       src/StartupDialog.cpp \
       src/License.cpp \
       src/Main.cpp \
       src/Updater.cpp \
       src/Elevation.cpp

OBJS = $(SRCS:.cpp=.o) src/TaskbarMonitor.res.o
TARGET = TaskbarMonitor.exe

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(CXXFLAGS) $(LDFLAGS)

build/sensors/EmbeddedSensors.rc: src/SensorBridge.cs tools/build_sensors.ps1
	powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_sensors.ps1 -Output build/sensors

src/TaskbarMonitor.res.o: src/TaskbarMonitor.rc src/TaskbarMonitor.manifest src/TaskbarMonitor.ico src/Resource.h src/Updater.ps1 src/SensorResources.rc build/sensors/EmbeddedSensors.rc
	$(RC) -I build/sensors -i src/TaskbarMonitor.rc -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f src/*.o src/*.res.o $(TARGET)

.PHONY: all clean
