#include <windows.h>

1 24 "TaskbarMonitor.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "TaskbarMonitor Open Source Project"
            VALUE "FileDescription",  "Native Windows Taskbar Hardware Monitor"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "TaskbarMonitor"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TaskbarMonitor Project"
            VALUE "OriginalFilename", "TaskbarMonitor.exe"
            VALUE "ProductName",      "TaskbarMonitor"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END